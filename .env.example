# OHMEGATO — variables d'environnement
# Copier en .env.local (développement). Ne jamais committer de vraie valeur.

# development | test | staging | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local : afficher les valeurs avec `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role) : serveur uniquement
SUPABASE_SECRET_KEY=

# Secret de dérivation des liens de suivi (32 caractères minimum, `openssl rand -hex 32`).
# Le changer invalide tous les liens de suivi existants.
TRACKING_TOKEN_SECRET=

# Paiement de test — interdit en production (l'application refuse de démarrer)
PAYMENT_TEST_MODE=true
# 32 caractères minimum, ex. `openssl rand -hex 32`
PAYMENT_TEST_WEBHOOK_SECRET=

# Lien de paiement marchand Wave (sans API) : commande confirmée au choix de Wave,
# paiement vérifié puis enregistré par OHMEGATO dans /admin. Ignoré si WAVE_API_KEY est renseignée.
WAVE_PAYMENT_LINK=

# Wave Checkout — À RENSEIGNER (identifiants marchands professionnels)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Orange Money — À RENSEIGNER (intégration à finaliser, voir docs/INTEGRATIONS.md)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_CODE=
ORANGE_MONEY_WEBHOOK_SECRET=

# Connexion par code — mode test : le code s'affiche à l'écran (interdit en production)
OTP_TEST_MODE=true

# WhatsApp Cloud API (Meta) — À RENSEIGNER pour envoyer les codes par WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèle de message « authentification » approuvé par Meta
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=fr
